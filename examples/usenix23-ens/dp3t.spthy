                                           & ReceiveInfected(idR, k, t)@t3
                                           & Corrupt(<'HA', cc>, 'CorruptHAState', skHA)@t4
                                           & hp = h(<k, t, r, 'test'>)
                                           & Corrupt(<'P', id>, 'CorruptPhoneSend', <sign(skHA, <cc, t, hp, 'postest'>), hp, k, t, r>)@t5

  , AvoidHAClaimInfected(tsClose, tsRisk) <=> Ex idI k cc skHA hp c_type r tc tt #t1 #t2 #t3 #t4.
               Corrupt(<'P', idI>, c_type, <r, tsClose>)@t1 & (c_type = 'CorruptPhoneTestDBRead' | c_type = 'CorruptPhoneTestDBWrite')
             & Corrupt(<'HA', cc>, 'CorruptHAState', skHA)@t2
