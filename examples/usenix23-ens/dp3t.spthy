:*/

/*:
**********************************************
Sanity Lemmas
**********************************************
:*/

lemma sanityAReceived:
    exists-trace
    "Ex id eph #i. Received(id, eph)@i
    & not (Ex r ty m #c. Corrupt(r, ty, m)@c)"

lemma sanityATestPositive:
    exists-trace
    "Ex id1 tsInf #tTest. TestPositive(id1, tsInf)@tTest
    & not (Ex r ty m #c. Corrupt(r, ty, m)@c)"

lemma sanityAGenSendEph:
    exists-trace
    "Ex id tn dy eph id2 #i #j. GenSendEph(id, dy, tn, eph)@i
                     & Received(id2, eph)@j
    & not (Ex r ty m #c. Corrupt(r, ty, m)@c)"

lemma sanityKeySendReceive:
    exists-trace
    "Ex idI daySend epochSend eph k place #t1 idV #t2.
       GenSendEph(idI,daySend, epochSend, eph)@t1
     & UseKey(idI, k)@t1
     & IsAt(idI, place, epochSend)@t1
     & Received(idV, eph)@t2
     & IsAt(idV, place, epochSend)@t2
     & not (Ex r ty m #c. Corrupt(r, ty, m)@c)"

lemma sanityPositiveSentReceivedPhoneRelease:
    exists-trace
    "Ex idI daySend epochSend eph k place #t1 idV #t2 timeTest #t3 daysend2 #t7.
        GenSendEph(idI,daySend, epochSend, eph)@t1
      & UseKey(idI, k)@t1
      & IsAt(idI, place, epochSend)@t1

      & Received(idV, eph)@t2
      & IsAt(idV, place, epochSend)@t2

      & TestPositive(idI, timeTest)@t3

      & ReleaseKey(idI, daysend2, k)@t7
      & not (Ex r ty m #c. Corrupt(r, ty, m)@c)"

lemma sanityPositiveSentReceivedBackendRelease:
    exists-trace
    "Ex idI daySend epochSend eph k place #t1 idV #t2 timeTest #t3 daysend2 #t7 bcc #t8.
        GenSendEph(idI,daySend, epochSend, eph)@t1
      & UseKey(idI, k)@t1
      & IsAt(idI, place, epochSend)@t1

      & Received(idV, eph)@t2
      & IsAt(idV, place, epochSend)@t2

      & TestPositive(idI, timeTest)@t3

      & ReleaseKey(idI, daysend2, k)@t7

      & BackendReleaseKey(bcc, k)@t8
      & not (Ex r ty m #c. Corrupt(r, ty, m)@c)"

lemma sanityPClaimAtRisk:
    exists-trace
    "Ex idR day tsClose #tClaim. PClaimAtRisk(idR, day, tsClose)@tClaim
    & not (Ex r ty m #c. Corrupt(r, ty, m)@c)"

lemma sanityAReleaseKey:
    exists-trace
    "Ex id t k #i. ReleaseKey(id, t, k)@i
    & not (Ex r ty m #c. Corrupt(r, ty, m)@c)"

lemma sanityABackend:
    exists-trace
    "Ex cc k #i. BackendReleaseKey(cc, k)@i
    & not (Ex r ty m #c. Corrupt(r, ty, m)@c)"

