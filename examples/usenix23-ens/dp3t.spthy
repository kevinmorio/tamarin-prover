  , ReceiveCorruptedKey(id) <=> Ex idI k t #i #j. ReceiveInfected(id, k, t)@i
                                              & Corrupt(<'P', idI>, 'CorruptPhoneKey', k)@j

  , BroadcastRecordedAtTime(t, tsRisk) <=> Ex id eph place #i #j #k. Corrupt(<'P', id>, 'CorruptPhoneReceived', eph)@i
                                                             & BLEwr(t, place, eph)@j
                                                             & Day(tsRisk)@k
                                                             & #i < #k
                                                             & #j < #k

  , CompromiseBackend(tsRisk) <=> Ex cc skB #i #j. Corrupt(<'B', cc>, 'CorruptBState', skB)@i
                                                 & Day(tsRisk)@j
                                                 & #i < #j

  , UploadBroadcastChoosenKey(idR) <=> Ex k cc ccp skHA hp t r id #t1 #t2 #t3 #t4 #t5.
                                             BackendReleaseKey(ccp, k)@t1
