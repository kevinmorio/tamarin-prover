          & hp = h(<k, tsClose, r, 'test'>)
         // Phone outputs notification received from HA
          & Corrupt(<'P', idI>, 'CorruptPhoneReceive', <'positive', sign(skHA, <cc, tsClose, hp, 'postest'>), hp, tc, tt>)@t2
         // Other phone uses this message and uploads id1's key to the backend.
         // Note: id1 never explicitely released its key.
